{
  "name": "duckgr",
  "private": true,
  "type": "module",
  "description": "DuckGR: a platform of grid worlds. Core in Rust (WebAssembly) and a web interface.",
  "scripts": {
    "wasm": "node tools/build-wasm.mjs",
    "packages": "node tools/export-packages.mjs",
    "site": "npm run wasm && node tools/build-site.mjs",
    "pretest": "npm run wasm",
    "test": "node --test \"tests/*.test.js\"",
    "preserve": "npm run wasm",
    "serve": "python3 -m http.server 8000 --directory web",
    "serve:site": "npm run site && python3 -m http.server 8000 --directory _site"
  }
}
